# Cloudflare Pages Headers for Pod Studio (podstudiotools.com)

# Security and Privacy Headers across all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block

# Static Asset Caching (Astro bundled chunks with content hashes)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon and Brand Icons
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# XML Sitemap and Robots
/sitemap-index.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=600

/robots.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=600

