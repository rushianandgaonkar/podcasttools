# Cloudflare Headers for Pod Studio (podstudiotools.com)

# Staging and preview host isolation (prevent accidental duplicate indexing)
https://:project.workers.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive

https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive

# Security and Privacy Headers across all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Static Asset Caching (Astro bundled chunks with content hashes)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Optimised tool illustrations & share cards (regenerated by scripts/, so revalidate weekly)
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Favicon and Brand Icons
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# XML Sitemap and Robots
/sitemap-index.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=600

/robots.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=600
