---
import ToolPageView from "../../../components/views/ToolPageView.astro";
import { toolRegistry, type ToolDefinition } from "../../../config/site";
import { nonDefaultLocales, type SupportedLocale } from "../../../i18n/languages";

export function getStaticPaths() {
  return nonDefaultLocales.flatMap((lang) =>
    toolRegistry.map((tool) => ({
      params: { lang, slug: tool.slug },
      props: { tool },
    }))
  );
}

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const { lang } = Astro.params as { lang: SupportedLocale };
---

<ToolPageView tool={tool} lang={lang} />
