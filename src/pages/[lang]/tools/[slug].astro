---
import Layout from "../../../layouts/Layout.astro";
import { siteConfig, toolRegistry, toolCategories, type ToolDefinition } from "../../../config/site";
import { ToolDispatcher } from "../../../components/tools/ToolDispatcher";
import { ToolIcon } from "../../../components/tools/ToolIcon";
import { nonDefaultLocales, type SupportedLocale } from "../../../i18n/languages";
import { useTranslations, getLocalizedPath } from "../../../i18n/utils";
import { getLocalizedTool } from "../../../i18n/toolsData";
import { getLocalizedToolFaqs } from "../../../i18n/toolFaqs";
import { getToolImage, getToolOgImage } from "../../../lib/toolImages";
import {
  ShieldCheck,
  Zap,
  CheckCircle2,
  ArrowRight,
  ChevronRight,
} from "lucide-react";

export function getStaticPaths() {
  return nonDefaultLocales.flatMap((lang) =>
    toolRegistry.map((tool) => ({
      params: { lang, slug: tool.slug },
      props: { tool },
    }))
  );
}

interface Props {
  tool: ToolDefinition;
}

const { tool: rawTool } = Astro.props;
const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
const tool = getLocalizedTool(rawTool, lang);
const toolFaqs = getLocalizedToolFaqs(tool.slug, lang);
const toolImage = getToolImage(rawTool.image);
const toolAccent = toolCategories.find((c) => c.id === rawTool.category)?.accent ?? "#7c3aed";

// Related tools from the same category or featured
const relatedTools = toolRegistry
  .filter((t) => t.slug !== tool.slug && (t.category === rawTool.category || t.featured))
  .slice(0, 3)
  .map((rel) => getLocalizedTool(rel, lang));

// Structured Data Schemas
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: tool.title,
  url: `${siteConfig.url}/${lang}/tools/${tool.slug}`,
  image: `${siteConfig.url}${tool.image}`,
  inLanguage: lang,
  description: tool.description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "All modern web browsers",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  browserRequirements: "Requires JavaScript",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: `${siteConfig.url}/${lang}`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t.nav.allTools,
      item: `${siteConfig.url}/${lang}/tools`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: tool.title,
      item: `${siteConfig.url}/${lang}/tools/${tool.slug}`,
    },
  ],
};

const toolFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: toolFaqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<Layout
  title={`${tool.title} | Pod Studio`}
  description={tool.description}
  lang={lang}
  canonicalUrl={`${siteConfig.url}/${lang}/tools/${tool.slug}`}
  ogImage={getToolOgImage(tool.slug)}
>
  <!-- Structured Data Injections -->
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(toolFaqSchema)} />

  <div class="w-full py-8 sm:py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-8">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-neutral-500 font-mono">
        <a href={getLocalizedPath("/", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.toolSteps.homeBreadcrumb}
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <a href={getLocalizedPath("/tools", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.allTools}
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <span class="text-neutral-900 dark:text-neutral-100 font-medium truncate">{tool.shortTitle}</span>
      </nav>

      <!-- Tool Header + Illustration -->
      <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_200px] lg:grid-cols-[minmax(0,1fr)_232px] gap-6 lg:gap-10 items-center">
      <div class="space-y-3">
        <div className="flex items-center gap-2">
          <div className="w-9 h-9 rounded-lg bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 flex items-center justify-center text-[#0070f3]">
            <ToolIcon name={tool.icon} className="w-5 h-5" />
          </div>
          <span className="font-mono text-xs uppercase px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400">
            {tool.categoryLabel}
          </span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white">
          {tool.title}
        </h1>

        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-3xl leading-relaxed">
          {tool.longDescription}
        </p>

        <!-- Privacy & Standards Badges -->
        <div class="flex flex-wrap items-center gap-2 pt-1">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 text-[11px] font-mono">
            <ShieldCheck className="w-3.5 h-3.5 text-emerald-500" />
            <span>{t.toolSteps.clientMemoryBadge}</span>
          </div>

          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 text-[11px] font-mono">
            <Zap className="w-3.5 h-3.5 text-amber-500" />
            <span>{t.toolSteps.specVerifiedBadge}</span>
          </div>
        </div>
      </div>

        <!-- Tool illustration (decorative; hidden on small screens so the tool stays above the fold) -->
        <figure class="hidden md:block relative" aria-hidden="true">
          <div class="absolute -inset-4 rounded-[28px] opacity-60 blur-2xl" style={`background: radial-gradient(closest-side, ${toolAccent}55, transparent)`}></div>
          <!-- <picture> + media query: phones (figure hidden) never download the illustration -->
          <picture>
            <source media="(min-width: 768px)" srcset={toolImage.srcSet} sizes="(min-width: 1024px) 232px, 200px" type="image/webp" />
            <img
              src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
              width={toolImage.width}
              height={toolImage.height}
              alt=""
              decoding="async"
              class="relative w-full aspect-[4/5] object-cover object-[50%_30%] rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-lg rotate-[2deg] hover:rotate-0 transition-transform duration-300"
            />
          </picture>
        </figure>
      </div>

      <!-- Interactive Tool Workspace (React 19 Island) -->
      <div class="w-full tool-workspace">
        <ToolDispatcher slug={tool.slug} lang={lang} client:load />
      </div>

      <!-- Technical Specifications & Deep Content -->
      <section class="border-t border-neutral-200 dark:border-neutral-800 pt-10 space-y-8">
        <div>
          <h2 class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white mb-2">
            {t.toolDetail.howToUse}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
            <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
              <span class="font-mono text-xs font-semibold text-[#0070f3] block mb-1">{t.toolSteps.step1Title}</span>
              <p class="text-xs text-neutral-600 dark:text-neutral-400">
                {t.toolSteps.step1Desc}
              </p>
            </div>
            <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
              <span class="font-mono text-xs font-semibold text-[#0070f3] block mb-1">{t.toolSteps.step2Title}</span>
              <p class="text-xs text-neutral-600 dark:text-neutral-400">
                {t.toolSteps.step2Desc}
              </p>
            </div>
            <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
              <span class="font-mono text-xs font-semibold text-[#0070f3] block mb-1">{t.toolSteps.step3Title}</span>
              <p class="text-xs text-neutral-600 dark:text-neutral-400">
                {t.toolSteps.step3Desc}
              </p>
            </div>
          </div>
        </div>

        <!-- Related Tools Section -->
        <div>
          <h2 class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white mb-4">
            {t.toolDetail.relatedTools}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {relatedTools.map((relTool) => (
              <a
                href={getLocalizedPath(`/tools/${relTool.slug}`, lang)}
                class="group p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <div class="w-6 h-6 rounded bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center text-neutral-700 dark:text-neutral-300">
                      <ToolIcon name={relTool.icon} className="w-3.5 h-3.5" />
                    </div>
                    <span class="text-xs font-semibold text-neutral-900 dark:text-white group-hover:text-[#0070f3] transition-colors">
                      {relTool.shortTitle}
                    </span>
                  </div>
                  <p class="text-xs text-neutral-500 line-clamp-2 mb-3">
                    {relTool.description}
                  </p>
                </div>
                <span class="text-xs font-medium text-[#0070f3] inline-flex items-center gap-1">
                  {t.toolsSection.launchTool} <ArrowRight className="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
                </span>
              </a>
            ))}
          </div>
        </div>

        <!-- Tool FAQ Accordion -->
        <div class="pt-6 border-t border-neutral-200 dark:border-neutral-800">
          <h2 class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white mb-2">
            {t.toolDetail.faqs}
          </h2>
          <p class="text-xs text-neutral-500 mb-4">
            {t.faq.subtitle}
          </p>
          <div class="space-y-3">
            {toolFaqs.map((faq) => (
              <details class="group rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] p-4 transition-all">
                <summary class="flex items-center justify-between font-medium text-xs sm:text-sm text-neutral-900 dark:text-white cursor-pointer list-none">
                  <span>{faq.question}</span>
                  <span class="text-neutral-400 group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <div class="pt-3 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed border-t border-neutral-100 dark:border-neutral-900 mt-3">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

