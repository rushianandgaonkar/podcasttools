---
import Layout from "../../../layouts/Layout.astro";
import { siteConfig } from "../../../config/site";
import { HomeToolGrid } from "../../../components/home/HomeToolGrid";
import { nonDefaultLocales, type SupportedLocale } from "../../../i18n/languages";
import { useTranslations } from "../../../i18n/utils";
import { Sparkles } from "lucide-react";

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
---

<Layout
  title={`${t.toolsSection.title} | Pod Studio`}
  description={t.toolsSection.subtitle}
  lang={lang}
  canonicalUrl={`${siteConfig.url}/${lang}/tools`}
>
  <div class="w-full py-10 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Header -->
      <div class="max-w-2xl mb-10">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 font-mono text-[11px] mb-3">
          <Sparkles className="w-3 h-3 text-[#0070f3]" />
          18 PRODUCTION UTILITIES
        </div>
        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white mb-3">
          {t.toolsSection.title}
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {t.toolsSection.subtitle}
        </p>
      </div>

      <!-- Directory Grid (React Island) -->
      <HomeToolGrid client:load lang={lang} />
    </div>
  </div>
</Layout>
