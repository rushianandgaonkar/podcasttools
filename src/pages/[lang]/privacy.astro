---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../config/site";
import { nonDefaultLocales, type SupportedLocale } from "../../i18n/languages";
import { useTranslations, getLocalizedPath } from "../../i18n/utils";
import { ShieldCheck, ArrowRight } from "lucide-react";

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
const p = t.legalPages.privacy;
---

<Layout
  title={`Privacy Policy | ${t.nav.privacy} — Pod Studio`}
  description="Read Pod Studio's transparent, 100% client-side privacy policy. Learn how our tools process calculations, artwork, and notes locally in your browser."
  lang={lang}
  canonicalUrl={`${siteConfig.url}/${lang}/privacy`}
>
  <div class="w-full py-10 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 font-mono text-[11px]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          {t.legalPages.privacyBadge}
        </div>
        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white">
          {t.nav.privacy}
        </h1>
        <p class="text-xs text-neutral-500 font-mono">
          {t.legalPages.lastUpdated}
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] space-y-6 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
        <section class="space-y-2">
          <h2 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white">{p.s1Title}</h2>
          <p>{p.s1P1}</p>
          <p>{p.s1P2}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white">{p.s2Title}</h2>
          <div class="space-y-2">
            <div class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-black space-y-1">
              <span class="font-semibold text-neutral-900 dark:text-white block text-xs">{p.s2P1Title}</span>
              <p class="text-neutral-500 text-xs">{p.s2P1Text}</p>
            </div>
            <div class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-black space-y-1">
              <span class="font-semibold text-neutral-900 dark:text-white block text-xs">{p.s2P2Title}</span>
              <p class="text-neutral-500 text-xs">{p.s2P2Text}</p>
            </div>
          </div>
        </section>

        <section class="space-y-2">
          <h2 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white">{p.s3Title}</h2>
          <p>{p.s3Text}</p>
        </section>

        <section class="space-y-2">
          <h2 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white">{p.s4Title}</h2>
          <p>{p.s4Text}</p>
        </section>

        <section class="space-y-2 pt-4 border-t border-neutral-100 dark:border-neutral-900">
          <h2 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white">{p.s5Title}</h2>
          <p>{p.s5Text}</p>
          <p class="pt-1">
            <a href={`mailto:${siteConfig.creator.contactEmail}`} class="text-[#0070f3] font-mono hover:underline inline-flex items-center gap-1">
              {siteConfig.creator.contactEmail}
            </a>
          </p>
        </section>
      </div>

      <div class="text-center">
        <a
          href={getLocalizedPath("/tools", lang)}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-black font-medium text-xs hover:opacity-90 transition-opacity"
        >
          {t.legalPages.exploreAllTools} <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </div>
</Layout>
