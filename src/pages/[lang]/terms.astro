---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../config/site";
import { nonDefaultLocales, type SupportedLocale } from "../../i18n/languages";
import { useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
---

<Layout
  title={`Terms of Service | ${t.nav.terms} — Pod Studio`}
  description="Review the terms and conditions for using Pod Studio's free podcast creator tools, sponsorship calculators, and formatting utilities."
  lang={lang}
  canonicalUrl={`${siteConfig.url}/${lang}/terms`}
>
  <div class="w-full py-10 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 font-mono text-[11px]">
          TERMS OF USE
        </div>
        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white">
          {t.nav.terms}
        </h1>
        <p class="text-xs text-neutral-500 font-mono">
          Last updated: November 1, 2026 • Effective Date: November 1, 2026
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] space-y-6 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
        <section class="space-y-2">
          <h2 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white">1. Agreement to Terms</h2>
          <p>
            By accessing or using <strong class="text-neutral-900 dark:text-white font-mono">podstudiotools.com</strong> (&ldquo;Pod Studio&rdquo;), you agree to be bound by these Terms of Service.
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white">2. Free, Client-Side Utility Nature</h2>
          <p>
            Pod Studio is engineered as a free, client-side toolkit for independent podcast creators and sound designers. We do not require accounts, logins, or payment to access our 18 utilities.
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white">3. Content Ownership</h2>
          <p>
            Any episode titles, show notes, scripts, hooks, or timestamps generated using Pod Studio belong 100% to you. We assert zero copyright or commercial claims over your generated works.
          </p>
        </section>
      </div>
    </div>
  </div>
</Layout>

