---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../config/site";
import { ContactForm } from "../../components/layout/ContactForm";
import { nonDefaultLocales, type SupportedLocale } from "../../i18n/languages";
import { useTranslations } from "../../i18n/utils";
import { Mail } from "lucide-react";

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
---

<Layout
  title={`Contact Pod Studio | ${t.nav.contact}`}
  description="Get in touch with the Pod Studio team for support, feature suggestions, or questions."
  lang={lang}
  canonicalUrl={`${siteConfig.url}/${lang}/contact`}
>
  <div class="w-full py-10 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 font-mono text-[11px]">
          <Mail className="w-3 h-3 text-[#0070f3]" />
          SUPPORT &amp; INQUIRIES
        </div>
        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white">
          {t.nav.contact} — Pod Studio
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-xl">
          Have a tool suggestion, feedback on our formulas, or want to report a platform spec update? We would love to hear from you.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Direct Email Card -->
        <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] space-y-3">
          <div class="w-8 h-8 rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center text-[#0070f3]">
            <Mail className="w-4 h-4" />
          </div>
          <h2 class="text-sm font-semibold text-neutral-900 dark:text-white">Direct Email</h2>
          <p class="text-xs text-neutral-500 leading-relaxed">
            For general support or feedback:
          </p>
          <a
            href={`mailto:${siteConfig.creator.contactEmail}`}
            class="text-xs font-mono font-medium text-[#0070f3] hover:underline block break-all"
          >
            {siteConfig.creator.contactEmail}
          </a>
          <div class="pt-2 border-t border-neutral-100 dark:border-neutral-900 text-[11px] font-mono text-neutral-400">
            Response: within 24-48 business hours.
          </div>
        </div>

        <!-- Contact Message Composer (React Island) -->
        <div class="md:col-span-2">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </div>
</Layout>

