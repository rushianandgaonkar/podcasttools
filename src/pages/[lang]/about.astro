---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../config/site";
import { nonDefaultLocales, type SupportedLocale } from "../../i18n/languages";
import { useTranslations, getLocalizedPath } from "../../i18n/utils";
import { ShieldCheck, Sparkles, ArrowRight } from "lucide-react";

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
---

<Layout
  title={`About Pod Studio | ${t.nav.about}`}
  description={t.footer.tagline}
  lang={lang}
  canonicalUrl={`${siteConfig.url}/${lang}/about`}
>
  <div class="w-full py-10 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-10">
      <!-- Header -->
      <div class="space-y-3">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 font-mono text-[11px]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          {t.aboutPage.badge}
        </div>
        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white leading-tight">
          {t.hero.titleStart} {t.hero.titleHighlight}.
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl">
          {t.footer.tagline}
        </p>
      </div>

      <!-- Core Principles -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] space-y-2.5">
          <div class="w-8 h-8 rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center text-emerald-500">
            <ShieldCheck className="w-4 h-4" />
          </div>
          <h2 class="text-sm font-semibold text-neutral-900 dark:text-white">{t.hero.trustPills.privacy}</h2>
          <p class="text-xs text-neutral-500 leading-relaxed">
            {t.hero.clientSideNotice}
          </p>
        </div>

        <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] space-y-2.5">
          <div class="w-8 h-8 rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center text-[#0070f3]">
            <Sparkles className="w-4 h-4" />
          </div>
          <h2 class="text-sm font-semibold text-neutral-900 dark:text-white">{t.hero.trustPills.free}</h2>
          <p class="text-xs text-neutral-500 leading-relaxed">
            {t.toolsSection.subtitle}
          </p>
        </div>
      </div>

      <!-- Story Card -->
      <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] space-y-3">
        <h2 class="text-base font-semibold text-neutral-900 dark:text-white">{t.aboutPage.whyTitle}</h2>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {t.hero.description}
        </p>
      </div>

      <div class="text-center pt-2">
        <a
          href={getLocalizedPath("/tools", lang)}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-black font-medium text-xs hover:opacity-90 transition-opacity"
        >
          {t.aboutPage.cta} <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </div>
</Layout>

