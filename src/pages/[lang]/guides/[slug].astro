---
import GuidePageView from "../../../components/views/GuidePageView.astro";
import { guidesRegistry, type GuideDefinition } from "../../../config/site";
import { nonDefaultLocales, type SupportedLocale } from "../../../i18n/languages";

export function getStaticPaths() {
  return nonDefaultLocales.flatMap((lang) =>
    guidesRegistry.map((guide) => ({
      params: { lang, slug: guide.slug },
      props: { guide },
    }))
  );
}

interface Props {
  guide: GuideDefinition;
}

const { guide } = Astro.props;
const { lang } = Astro.params as { lang: SupportedLocale };
---

<GuidePageView guide={guide} lang={lang} />
