---
import Layout from "../../../layouts/Layout.astro";
import { siteConfig, guidesRegistry, type GuideDefinition } from "../../../config/site";
import { nonDefaultLocales, type SupportedLocale } from "../../../i18n/languages";
import { useTranslations, getLocalizedPath } from "../../../i18n/utils";
import { getLocalizedGuide } from "../../../i18n/guidesData";
import { Clock, ChevronRight, ArrowRight, CheckCircle2 } from "lucide-react";

export function getStaticPaths() {
  return nonDefaultLocales.flatMap((lang) =>
    guidesRegistry.map((guide) => ({
      params: { lang, slug: guide.slug },
      props: { guide },
    }))
  );
}

interface Props {
  guide: GuideDefinition;
}

const { guide } = Astro.props;
const { lang } = Astro.params as { lang: SupportedLocale; slug: string };
const t = useTranslations(lang);
const locGuide = getLocalizedGuide(guide, lang);
---

<Layout
  title={`${locGuide.title} | ${t.nav.guides} — Pod Studio`}
  description={locGuide.description}
  lang={lang}
  canonicalUrl={`${siteConfig.url}/${lang}/guides/${guide.slug}`}
>
  <div class="w-full py-8 sm:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-neutral-500 font-mono">
        <a href={getLocalizedPath("/", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          Home
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <a href={getLocalizedPath("/guides", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.guides}
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <span class="text-neutral-900 dark:text-neutral-100 font-medium truncate">{locGuide.title}</span>
      </nav>

      <!-- Header -->
      <div class="space-y-3 pb-6 border-b border-neutral-200 dark:border-neutral-800">
        <div class="flex items-center gap-2 text-xs">
          <span class="font-mono text-[10px] uppercase px-1.5 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400">
            {locGuide.category}
          </span>
          <span class="flex items-center gap-1 text-neutral-400 font-mono text-[11px]">
            <Clock className="w-3 h-3" />
            {locGuide.readTime}
          </span>
          <span class="text-neutral-400 font-mono text-[11px]">• {locGuide.publishedAt}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white leading-tight">
          {locGuide.title}
        </h1>

        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {locGuide.description}
        </p>
      </div>

      <!-- Localized Guide Content -->
      <article class="space-y-8 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
        {locGuide.sections.map((section) => (
          <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white">
              {section.heading}
            </h2>

            {section.paragraphs.map((p) => (
              <p>{p}</p>
            ))}

            {section.formula && (
              <div class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] font-mono text-xs text-[#0070f3]">
                {section.formula}
              </div>
            )}

            {section.cards && (
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                {section.cards.map((card) => (
                  <div class={`p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] ${card.highlight ? 'border-[#0070f3]/40' : ''}`}>
                    <span class={`font-mono text-[10px] uppercase block mb-1 ${card.highlight ? 'text-[#0070f3]' : 'text-neutral-400'}`}>
                      {card.title}
                    </span>
                    {card.value && (
                      <div class={`text-lg font-semibold ${card.highlight ? 'text-[#0070f3]' : 'text-neutral-900 dark:text-white'}`}>
                        {card.value}
                      </div>
                    )}
                    <p class="text-[11px] text-neutral-500 mt-1">
                      {card.description}
                    </p>
                  </div>
                ))}
              </div>
            )}

            {section.list && (
              <div class="space-y-2">
                {section.list.map((item) => (
                  <div class="flex items-start gap-2.5 p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                    <CheckCircle2 className="w-4 h-4 text-emerald-500 mt-0.5 flex-shrink-0" />
                    <div>
                      <strong class="text-neutral-900 dark:text-white font-semibold text-xs block mb-0.5">
                        {item.title}
                      </strong>
                      <p class="text-neutral-600 dark:text-neutral-400 text-xs">
                        {item.description}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </section>
        ))}

        <!-- Direct Tool CTA -->
        {locGuide.cta && (
          <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] flex flex-col sm:flex-row sm:items-center justify-between gap-4 mt-6">
            <div class="space-y-0.5">
              <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">
                {locGuide.cta.title}
              </h3>
              <p class="text-xs text-neutral-500">
                {locGuide.cta.description}
              </p>
            </div>
            <a
              href={getLocalizedPath(`/tools/${locGuide.cta.toolSlug}`, lang)}
              class="px-4 py-2 rounded-full bg-[#171717] dark:bg-white text-white dark:text-black font-medium text-xs inline-flex items-center gap-1.5 whitespace-nowrap self-start sm:self-auto hover:opacity-90 transition-opacity"
            >
              {locGuide.cta.buttonText} <ArrowRight className="w-3.5 h-3.5" />
            </a>
          </div>
        )}
      </article>
    </div>
  </div>
</Layout>
