---
import Layout from "../../../layouts/Layout.astro";
import { siteConfig, guidesRegistry, type GuideDefinition } from "../../../config/site";
import { nonDefaultLocales, type SupportedLocale } from "../../../i18n/languages";
import { useTranslations, getLocalizedPath } from "../../../i18n/utils";
import { Clock, ChevronRight, ArrowRight, CheckCircle2 } from "lucide-react";

export function getStaticPaths() {
  return nonDefaultLocales.flatMap((lang) =>
    guidesRegistry.map((guide) => ({
      params: { lang, slug: guide.slug },
      props: { guide },
    }))
  );
}

interface Props {
  guide: GuideDefinition;
}

const { guide } = Astro.props;
const { lang, slug } = Astro.params as { lang: SupportedLocale; slug: string };
const t = useTranslations(lang);
---

<Layout
  title={`${guide.title} | ${t.nav.guides} — Pod Studio`}
  description={guide.description}
  lang={lang}
  canonicalUrl={`${siteConfig.url}/${lang}/guides/${guide.slug}`}
>
  <div class="w-full py-8 sm:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-neutral-500 font-mono">
        <a href={getLocalizedPath("/", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          Home
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <a href={getLocalizedPath("/guides", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.guides}
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <span class="text-neutral-900 dark:text-neutral-100 font-medium truncate">{guide.title}</span>
      </nav>

      <!-- Header -->
      <div class="space-y-3 pb-6 border-b border-neutral-200 dark:border-neutral-800">
        <div class="flex items-center gap-2 text-xs">
          <span class="font-mono text-[10px] uppercase px-1.5 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400">
            {guide.category}
          </span>
          <span class="flex items-center gap-1 text-neutral-400 font-mono text-[11px]">
            <Clock className="w-3 h-3" />
            {guide.readTime}
          </span>
          <span class="text-neutral-400 font-mono text-[11px]">• {guide.publishedAt}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white leading-tight">
          {guide.title}
        </h1>

        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {guide.description}
        </p>
      </div>

      <!-- Guide Content depending on slug -->
      <article class="space-y-8 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
        {slug === "podcast-sponsorship-cpm-guide-2026" && (
          <>
            <section class="space-y-3">
              <h2 class="text-lg font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white">Understanding Podcast CPM Pricing</h2>
              <p>
                In the podcast advertising industry, sponsorship inventory is priced using the <strong class="text-neutral-900 dark:text-white">CPM metric</strong> (Cost Per Mille, Latin for thousand downloads). A CPM represents the fee a sponsor pays for every 1,000 verified downloads an episode achieves over its initial 30 to 45-day release window.
              </p>
              <div class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] font-mono text-xs text-[#0070f3]">
                Total Ad Cost = (Estimated 30-Day Downloads / 1,000) × CPM Rate
              </div>
            </section>

            <section class="space-y-3">
              <h2 class="text-lg font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white">2026 Industry CPM Benchmarks</h2>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                  <span class="font-mono text-[10px] uppercase text-neutral-400 block mb-1">Pre-Roll (15-30s)</span>
                  <div class="text-lg font-semibold text-neutral-900 dark:text-white">$15 – $18 CPM</div>
                  <p class="text-[11px] text-neutral-500 mt-1">First 5 minutes of episode</p>
                </div>
                <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                  <span class="font-mono text-[10px] uppercase text-[#0070f3] block mb-1">Mid-Roll (60s Host-Read)</span>
                  <div class="text-lg font-semibold text-[#0070f3]">$25 – $35 CPM</div>
                  <p class="text-[11px] text-neutral-500 mt-1">Center of episode, highest retention</p>
                </div>
                <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                  <span class="font-mono text-[10px] uppercase text-neutral-400 block mb-1">Post-Roll (15s)</span>
                  <div class="text-lg font-semibold text-neutral-900 dark:text-white">$10 – $14 CPM</div>
                  <p class="text-[11px] text-neutral-500 mt-1">Outro audio segment</p>
                </div>
              </div>
            </section>

            <!-- Direct Tool CTA -->
            <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-0.5">
                <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">Calculate Your Show&apos;s Revenue</h3>
                <p class="text-xs text-neutral-500">
                  Input your downloads, frequency, and ad slots into our free calculator.
                </p>
              </div>
              <a
                href={getLocalizedPath("/tools/monetization-calculator", lang)}
                class="px-4 py-2 rounded-full bg-[#171717] dark:bg-white text-white dark:text-black font-medium text-xs inline-flex items-center gap-1.5 whitespace-nowrap self-start sm:self-auto hover:opacity-90 transition-opacity"
              >
                Open Sponsorship Calculator <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </div>
          </>
        )}

        {slug === "apple-spotify-cover-art-specs-guide" && (
          <>
            <section class="space-y-3">
              <h2 class="text-lg font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white">Official Apple Podcasts &amp; Spotify Artwork Specifications</h2>
              <p>
                Your podcast cover art is the single most important visual asset for attracting listeners in directory search results. Apple Podcasts, Spotify, and YouTube Music enforce strict technical standards:
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                  <div class="text-xs font-semibold text-neutral-900 dark:text-white mb-1">Recommended Dimensions</div>
                  <div class="font-mono text-sm text-[#0070f3]">3000 × 3000 px</div>
                  <p class="text-[11px] text-neutral-500 mt-1">Minimum 1400 × 1400 px, 1:1 square ratio</p>
                </div>
                <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                  <div class="text-xs font-semibold text-neutral-900 dark:text-white mb-1">File Format &amp; Color Space</div>
                  <div class="font-mono text-sm text-[#0070f3]">JPEG or PNG in 72 DPI sRGB</div>
                  <p class="text-[11px] text-neutral-500 mt-1">Max 512KB recommended for fast CDN loading</p>
                </div>
              </div>
            </section>

            <!-- Direct Tool CTA -->
            <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-0.5">
                <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">Test Your Artwork Specs Locally</h3>
                <p class="text-xs text-neutral-500">
                  Drop your cover art to simulate Apple &amp; Spotify lockscreens.
                </p>
              </div>
              <a
                href={getLocalizedPath("/tools/cover-art-preview", lang)}
                class="px-4 py-2 rounded-full bg-[#171717] dark:bg-white text-white dark:text-black font-medium text-xs inline-flex items-center gap-1.5 whitespace-nowrap self-start sm:self-auto hover:opacity-90 transition-opacity"
              >
                Launch Cover Art Previewer <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </div>
          </>
        )}

        {slug === "high-ctr-podcast-episode-titles" && (
          <>
            <section class="space-y-3">
              <h2 class="text-lg font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white">Psychological Frameworks for Podcast Episode Titles</h2>
              <p>
                Most creators spend 5 hours recording and editing an episode, but less than 30 seconds deciding the title. A weak title like &ldquo;Episode 42: Chatting With Dave&rdquo; generates virtually zero clicks from non-subscribers.
              </p>
              <div class="space-y-2">
                <div class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                  <span class="font-semibold text-neutral-900 dark:text-white block text-xs">The Counter-Intuitive Truth</span>
                  <p class="text-neutral-500 text-xs mt-1">Formula: Why Most People Fail at [Topic] (And What to Do Instead)</p>
                </div>
                <div class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                  <span class="font-semibold text-neutral-900 dark:text-white block text-xs">The Specific Number + Secret Method</span>
                  <p class="text-neutral-500 text-xs mt-1">Formula: The 3 Rules Behind [Guest Name]&apos;s [Achievement]</p>
                </div>
              </div>
            </section>

            <!-- Direct Tool CTA -->
            <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-0.5">
                <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">Generate 30+ High-CTR Titles</h3>
                <p class="text-xs text-neutral-500">
                  Input your topic to instantly preview tested psychological formulas.
                </p>
              </div>
              <a
                href={getLocalizedPath("/tools/episode-title-generator", lang)}
                class="px-4 py-2 rounded-full bg-[#171717] dark:bg-white text-white dark:text-black font-medium text-xs inline-flex items-center gap-1.5 whitespace-nowrap self-start sm:self-auto hover:opacity-90 transition-opacity"
              >
                Open Title Generator <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </div>
          </>
        )}
      </article>
    </div>
  </div>
</Layout>

