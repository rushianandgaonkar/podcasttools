---
import Layout from "../../../layouts/Layout.astro";
import { siteConfig, guidesRegistry } from "../../../config/site";
import { nonDefaultLocales, type SupportedLocale } from "../../../i18n/languages";
import { useTranslations, getLocalizedPath } from "../../../i18n/utils";
import { BookOpen, Clock, ArrowRight } from "lucide-react";

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
---

<Layout
  title={`Podcasting Guides & Research | ${t.nav.guides} — Pod Studio`}
  description="Field-tested articles covering monetization benchmarks, directory artwork specifications, and audience growth mechanics."
  lang={lang}
  canonicalUrl={`${siteConfig.url}/${lang}/guides`}
>
  <div class="w-full py-10 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-10">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 font-mono text-[11px]">
          <BookOpen className="w-3 h-3 text-[#0070f3]" />
          RESEARCH &amp; PLAYBOOKS
        </div>
        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white">
          {t.nav.guides} — Pod Studio
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl">
          Field-tested articles covering monetization benchmarks, directory artwork specifications, and audience growth mechanics. Grounded in verified 2026 audio data.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {guidesRegistry.map((guide) => (
          <a
            href={getLocalizedPath(`/guides/${guide.slug}`, lang)}
            class="group p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs text-neutral-400 mb-2.5">
                <span class="font-mono text-[10px] uppercase px-1.5 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400">
                  {guide.category}
                </span>
                <span class="flex items-center gap-1 font-mono text-[10px]">
                  <Clock className="w-3 h-3" />
                  {guide.readTime}
                </span>
              </div>
              <h2 class="text-sm font-semibold text-neutral-900 dark:text-white group-hover:text-[#0070f3] dark:group-hover:text-[#0070f3] transition-colors mb-1.5">
                {guide.title}
              </h2>
              <p class="text-xs text-neutral-500 leading-relaxed line-clamp-3 mb-4">
                {guide.description}
              </p>
            </div>

            <div class="pt-3 border-t border-neutral-100 dark:border-neutral-900 text-xs font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-[#0070f3] inline-flex items-center gap-1">
              Read Guide <ArrowRight className="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
