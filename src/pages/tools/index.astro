---
import Layout from "../../layouts/Layout.astro";
import { HomeToolGrid } from "../../components/home/HomeToolGrid";
import { Sparkles } from "lucide-react";
---

<Layout
  title="All 18 Free Podcast Creator Tools Directory | Pod Studio"
  description="Explore our complete suite of 18 free podcast tools. Generate episode titles, format show notes, calculate sponsorship earnings, and test cover art specs 100% in your browser."
>
  <div class="w-full py-12 sm:py-20 bg-[#0A0A16]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-semibold mb-4">
          <Sparkles className="w-3.5 h-3.5" />
          18 Interactive Utilities
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
          Podcast Creator Tools Directory
        </h1>
        <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
          Every tool in our suite is designed to solve a specific podcast production or marketing challenge. Filter by category or search by keyword to get started. Zero signups, zero server uploads.
        </p>
      </div>

      <!-- Directory Grid (React Island) -->
      <HomeToolGrid client:load />
    </div>
  </div>
</Layout>
