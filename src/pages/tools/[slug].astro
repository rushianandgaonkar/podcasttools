---
import Layout from "../../layouts/Layout.astro";
import { siteConfig, toolRegistry, type ToolDefinition } from "../../config/site";
import { ToolDispatcher } from "../../components/tools/ToolDispatcher";
import { ToolIcon } from "../../components/tools/ToolIcon";
import {
  ShieldCheck,
  Zap,
  CheckCircle2,
  ArrowRight,
  ChevronRight,
} from "lucide-react";

export async function getStaticPaths() {
  return toolRegistry.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;

// Related tools from the same category or featured
const relatedTools = toolRegistry
  .filter((t) => t.slug !== tool.slug && (t.category === tool.category || t.featured))
  .slice(0, 3);

// Structured Data Schemas
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: tool.title,
  url: `${siteConfig.url}/tools/${tool.slug}`,
  description: tool.description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "All modern web browsers",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  browserRequirements: "Requires JavaScript",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.url,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Tools",
      item: `${siteConfig.url}/tools`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: tool.title,
      item: `${siteConfig.url}/tools/${tool.slug}`,
    },
  ],
};
---

<Layout
  title={`${tool.title} | Free Online - Pod Studio`}
  description={tool.description}
  canonicalUrl={`${siteConfig.url}/tools/${tool.slug}`}
>
  <!-- Structured Data Injections -->
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="w-full py-8 sm:py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-8">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-neutral-500 font-mono">
        <a href="/" class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          Home
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <a href="/tools" class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          Tools
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <span class="text-neutral-900 dark:text-neutral-100 font-medium truncate">{tool.shortTitle}</span>
      </nav>

      <!-- Tool Header -->
      <div class="space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-mono text-[10px] uppercase font-medium tracking-wider px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400">
            {tool.categoryLabel}
          </span>
          {tool.badge && (
            <span class="font-mono text-[10px] uppercase font-semibold tracking-wider px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 bg-[#171717] dark:bg-white text-white dark:text-black">
              {tool.badge}
            </span>
          )}
          <div class="inline-flex items-center gap-1 text-[10px] font-mono text-emerald-600 dark:text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/20 bg-emerald-500/5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 100% Client-Side Privacy
          </div>
        </div>

        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white leading-tight">
          {tool.title}
        </h1>

        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-3xl">
          {tool.longDescription}
        </p>
      </div>

      <!-- Primary Interactive Tool Workspace (React Island) -->
      <div class="pt-2">
        <ToolDispatcher slug={tool.slug} client:load />
      </div>

      <!-- How-To & Features Section -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-8 border-t border-neutral-200 dark:border-neutral-800">
        <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] space-y-3">
          <h2 class="font-mono text-xs uppercase tracking-wider text-neutral-900 dark:text-neutral-100 font-semibold flex items-center gap-2">
            <Zap className="w-3.5 h-3.5 text-[#0070f3]" />
            How to Use This Tool in 3 Steps
          </h2>
          <ol class="space-y-2 text-xs text-neutral-600 dark:text-neutral-400">
            <li class="flex items-start gap-2">
              <span class="font-mono text-[10px] font-semibold text-neutral-400 w-4 mt-0.5">01</span>
              <span>Enter your episode subject, guest details, or audio parameters into the input fields above.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-mono text-[10px] font-semibold text-neutral-400 w-4 mt-0.5">02</span>
              <span>Review the instant results, toggle categories or formulas, and adjust parameters to fit your show.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-mono text-[10px] font-semibold text-neutral-400 w-4 mt-0.5">03</span>
              <span>Click one-click copy or export to TXT/Markdown, and paste directly into your podcast hosting service.</span>
            </li>
          </ol>
        </div>

        <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] space-y-3">
          <h2 class="font-mono text-xs uppercase tracking-wider text-neutral-900 dark:text-neutral-100 font-semibold flex items-center gap-2">
            <ShieldCheck className="w-3.5 h-3.5 text-emerald-500" />
            Zero-Server Privacy Guarantee
          </h2>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Unlike AI tools that transmit your episode ideas and drafts to third-party cloud servers, this tool operates 100% inside your local browser runtime.
          </p>
          <ul class="space-y-1.5 text-xs text-neutral-500">
            <li class="flex items-center gap-1.5">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" />
              No account or sign up required
            </li>
            <li class="flex items-center gap-1.5">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" />
              Zero audio or text uploads to remote databases
            </li>
            <li class="flex items-center gap-1.5">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" />
              Fast, instant execution with offline compatibility
            </li>
          </ul>
        </div>
      </div>

      <!-- Related Tools Internal Linking Grid -->
      <div class="pt-6 border-t border-neutral-200 dark:border-neutral-800 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-neutral-900 dark:text-white">
            Related Podcast Tools
          </h2>
          <a
            href="/tools"
            class="text-xs text-[#0070f3] hover:underline font-medium inline-flex items-center gap-1"
          >
            All Tools <ArrowRight className="w-3 h-3" />
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {relatedTools.map((rel) => (
            <a
              href={`/tools/${rel.slug}`}
              class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors group flex flex-col justify-between"
            >
              <div>
                <div class="w-7 h-7 rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 flex items-center justify-center mb-2 group-hover:text-[#0070f3] transition-colors">
                  <ToolIcon name={rel.icon} className="w-3.5 h-3.5" />
                </div>
                <h3 class="text-xs font-semibold text-neutral-900 dark:text-white group-hover:text-[#0070f3] transition-colors mb-1 line-clamp-1">
                  {rel.title}
                </h3>
                <p class="text-[11px] text-neutral-500 line-clamp-2 leading-relaxed">
                  {rel.description}
                </p>
              </div>
              <span class="text-[10px] font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-[#0070f3] mt-3 inline-flex items-center gap-0.5">
                Open Tool &rarr;
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
