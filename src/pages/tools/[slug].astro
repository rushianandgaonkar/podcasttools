---
import ToolPageView from "../../components/views/ToolPageView.astro";
import { toolRegistry, type ToolDefinition } from "../../config/site";
import { defaultLocale } from "../../i18n/languages";

export function getStaticPaths() {
  return toolRegistry.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
---

<ToolPageView tool={tool} lang={defaultLocale} />
