---
import Layout from "../../layouts/Layout.astro";
import { guidesRegistry } from "../../config/site";
import { BookOpen, Clock, ArrowRight } from "lucide-react";
---

<Layout
  title="Podcasting Guides & Industry Playbooks (2026) | Pod Studio"
  description="Expert, data-backed guides for podcast creators. Learn verified 2026 CPM sponsorship rates, Apple/Spotify cover art specs, and psychological episode title formulas."
>
  <div class="w-full py-12 sm:py-20 bg-[#0A0A16]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="space-y-4">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-semibold">
          <BookOpen className="w-3.5 h-3.5" /> Topical Authority Playbooks
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Podcasting Guides &amp; Research
        </h1>
        <p class="text-base sm:text-lg text-slate-400 leading-relaxed max-w-3xl">
          In-depth, field-tested articles covering monetization benchmarks, directory artwork specifications, and audience growth mechanics. Grounded in 2026 audio industry data.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {guidesRegistry.map((guide) => (
          <a
            href={`/guides/${guide.slug}`}
            class="group p-6 rounded-2xl bg-studio-card border border-studio-border hover:border-orange-500/40 hover:bg-studio-elevated transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                <span class="px-2.5 py-0.5 rounded-full bg-studio-dark border border-studio-border text-orange-400 font-semibold">
                  {guide.category}
                </span>
                <span class="flex items-center gap-1 font-mono text-[11px]">
                  <Clock className="w-3.5 h-3.5" />
                  {guide.readTime}
                </span>
              </div>
              <h2 class="text-base font-bold text-white group-hover:text-orange-400 transition-colors mb-2">
                {guide.title}
              </h2>
              <p class="text-xs text-slate-400 leading-relaxed mb-6">
                {guide.description}
              </p>
            </div>

            <div class="pt-3 border-t border-studio-border/50 text-xs font-semibold text-orange-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              Read Playbook &rarr;
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
