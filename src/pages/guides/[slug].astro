---
import GuidePageView from "../../components/views/GuidePageView.astro";
import { guidesRegistry, type GuideDefinition } from "../../config/site";
import { defaultLocale } from "../../i18n/languages";

export function getStaticPaths() {
  return guidesRegistry.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: GuideDefinition;
}

const { guide } = Astro.props;
---

<GuidePageView guide={guide} lang={defaultLocale} />
