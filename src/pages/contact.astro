---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
import { ContactForm } from "../components/layout/ContactForm";
import { Mail } from "lucide-react";
---

<Layout
  title="Contact the Pod Studio Team | Free Podcast Creator Toolkit"
  description="Get in touch with the Pod Studio team for support, feature suggestions, or questions."
>
  <div class="w-full py-12 sm:py-20 bg-[#0A0A16]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-semibold">
          <Mail className="w-3.5 h-3.5" /> Support &amp; Inquiries
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Contact the Pod Studio Team
        </h1>
        <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
          Have a tool suggestion, feedback on our formulas, or want to report a platform spec update? We would love to hear from you.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Direct Email Card -->
        <div class="p-6 rounded-2xl bg-studio-card border border-studio-border space-y-4">
          <div class="w-10 h-10 rounded-xl bg-orange-500/10 text-orange-400 border border-orange-500/20 flex items-center justify-center">
            <Mail className="w-5 h-5" />
          </div>
          <h2 class="text-base font-bold text-white">Direct Email</h2>
          <p class="text-xs text-slate-400 leading-relaxed">
            For general support, partnership inquiries, or tool bug reports:
          </p>
          <a
            href={`mailto:${siteConfig.creator.contactEmail}`}
            class="text-xs font-semibold text-orange-400 hover:text-orange-300 transition-colors block break-all font-mono"
          >
            {siteConfig.creator.contactEmail}
          </a>
          <div class="pt-2 border-t border-studio-border/60 text-[11px] text-slate-500">
            Response time: typically within 24-48 business hours.
          </div>
        </div>

        <!-- Contact Message Composer (React Island) -->
        <div class="md:col-span-2">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </div>
</Layout>
