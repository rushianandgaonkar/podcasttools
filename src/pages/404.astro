---
import Layout from "../layouts/Layout.astro";
import { ArrowRight, Home, Compass } from "lucide-react";
import { toolRegistry } from "../config/site";
import { getToolImage } from "../lib/toolImages";
import SignalLost from "../components/brand/SignalLost.astro";

const featuredTools = toolRegistry.slice(0, 4);
---

<Layout
  title="404 — Page Not Found | Pod Studio"
  description="Sorry, the podcast creator tool or guide you were looking for could not be found. Explore our 20 free audio production tools."
  noindex={true}
>
  <div class="w-full py-16 sm:py-24 min-h-[70vh] flex items-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center space-y-6">
      <SignalLost class="w-full max-w-sm h-auto mx-auto" />

      <div class="space-y-2">
        <span class="font-mono text-[11px] uppercase tracking-wider text-neutral-400">ERROR 404</span>
        <h1 class="font-display text-3xl sm:text-[2.6rem] font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white">
          Track Not Found
        </h1>
        <p class="text-xs sm:text-sm text-neutral-500 max-w-md mx-auto">
          The frequency or page you tuned into does not exist. Browse our free creator tools below.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-2.5">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#a9583e] hover:bg-[#8f4630] text-white font-medium text-xs hover:opacity-90 transition-opacity"
        >
          <Home className="w-3.5 h-3.5" /> Studio Home
        </a>
        <a
          href="/tools"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1f1e1b] text-neutral-800 dark:text-neutral-200 hover:bg-neutral-50 dark:hover:bg-neutral-900 font-medium text-xs transition-colors"
        >
          <Compass className="w-3.5 h-3.5" /> All 20 Tools
        </a>
      </div>

      <div class="pt-6 border-t border-neutral-200 dark:border-neutral-800 text-left">
        <h2 class="font-mono text-[11px] uppercase tracking-wider text-neutral-400 mb-3 text-center">
          Popular Free Podcast Tools
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {featuredTools.map((tool) => (
            <a
              href={`/tools/${tool.slug}`}
              class="p-3.5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1f1e1b] hover:border-neutral-400 dark:hover:border-neutral-600 group transition-colors flex items-center justify-between"
            >
              <img
                src={getToolImage(tool.image).src.replace("-lg.webp", "-sm.webp")}
                width="40"
                height="50"
                alt=""
                loading="lazy"
                decoding="async"
                class="w-10 h-10 rounded-md object-cover object-[50%_30%] border border-neutral-200 dark:border-neutral-800 shrink-0 mr-3"
              />
              <div class="flex-1 min-w-0">
                <span class="font-mono text-[9px] uppercase text-neutral-400 block">{tool.category}</span>
                <span class="text-xs font-semibold text-neutral-900 dark:text-white group-hover:text-[#a9583e] transition-colors">
                  {tool.title}
                </span>
              </div>
              <ArrowRight className="w-3.5 h-3.5 text-neutral-400 group-hover:text-[#a9583e] group-hover:translate-x-0.5 transition-transform" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
