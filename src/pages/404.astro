---
import Layout from "../layouts/Layout.astro";
import { Mic, ArrowRight, Home, Compass } from "lucide-react";
import { toolRegistry } from "../config/site";

const featuredTools = toolRegistry.slice(0, 4);
---

<Layout
  title="404 — Page Not Found | Pod Studio"
  description="Sorry, the podcast creator tool or guide you were looking for could not be found. Explore our 18 free audio production tools."
  noindex={true}
>
  <div class="w-full py-16 sm:py-24 bg-[#0A0A16] min-h-[75vh] flex items-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-orange-500/10 border border-orange-500/20 text-orange-400 mx-auto">
        <Mic className="w-10 h-10 animate-pulse" />
      </div>

      <div class="space-y-3">
        <span class="text-xs uppercase tracking-widest font-bold text-orange-500">Error 404</span>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          Track Not Found
        </h1>
        <p class="text-sm sm:text-base text-slate-400 max-w-lg mx-auto">
          The frequency you tuned into doesn&apos;t exist or has moved to a new studio room. Check out our suite of free podcast utilities below.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-orange-500 hover:bg-orange-600 text-white font-semibold text-sm transition-all shadow-lg shadow-orange-500/20"
        >
          <Home className="w-4 h-4" /> Studio Home
        </a>
        <a
          href="/tools"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-studio-card hover:bg-studio-card-hover border border-studio-border text-slate-200 font-semibold text-sm transition-all"
        >
          <Compass className="w-4 h-4" /> Browse All 18 Tools
        </a>
      </div>

      <div class="pt-8 border-t border-studio-border/60 text-left">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 text-center">
          Popular Free Podcast Tools
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {featuredTools.map((tool) => (
            <a
              href={`/tools/${tool.slug}`}
              class="p-4 rounded-xl bg-studio-card border border-studio-border hover:border-orange-500/40 group transition-all flex items-center justify-between"
            >
              <div>
                <span class="text-xs font-semibold text-orange-400 block">{tool.category}</span>
                <span class="text-sm font-bold text-white group-hover:text-orange-300 transition-colors">
                  {tool.title}
                </span>
              </div>
              <ArrowRight className="w-4 h-4 text-slate-500 group-hover:text-orange-400 group-hover:translate-x-1 transition-all" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
