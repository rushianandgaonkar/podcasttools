---
/**
 * About-page brand visual: a tilted mosaic of tool illustrations + a localized stats row.
 */
import { toolRegistry } from "../../config/site";
import { getToolImage } from "../../lib/toolImages";
import type { SupportedLocale } from "../../i18n/languages";

interface Props {
  lang: SupportedLocale;
}
const { lang } = Astro.props;

const labels: Record<SupportedLocale, [string, string, string, string]> = {
  en: ["free tools", "languages", "files uploaded", "to use"],
  es: ["herramientas gratis", "idiomas", "archivos subidos", "de coste"],
  ja: ["無料ツール", "言語", "アップロード", "利用料金"],
  fr: ["outils gratuits", "langues", "fichiers envoyés", "pour l'utiliser"],
  de: ["kostenlose Tools", "Sprachen", "hochgeladene Dateien", "Kosten"],
  pt: ["ferramentas grátis", "idiomas", "arquivos enviados", "para usar"],
  ko: ["무료 도구", "개 언어", "업로드 파일", "이용 요금"],
  it: ["strumenti gratuiti", "lingue", "file caricati", "per usarli"],
};
const l = labels[lang] ?? labels.en;
const stats = [
  [String(toolRegistry.length), l[0]],
  ["8", l[1]],
  ["0", l[2]],
  ["$0", l[3]],
];

const images = toolRegistry.slice(0, 10).map((t) => getToolImage(t.image));
---

<div class="relative rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-[#0a0a0a] overflow-hidden">
  <div class="relative h-44 sm:h-48 overflow-hidden" aria-hidden="true">
    <div class="absolute -inset-x-10 top-3 flex gap-3 -rotate-3 mosaic-drift">
      {images.map((img) => (
        <img
          src={img.src}
          srcset={img.srcSet}
          sizes="140px"
          width={img.width}
          height={img.height}
          alt=""
          loading="lazy"
          decoding="async"
          class="w-[112px] sm:w-[124px] shrink-0 aspect-[4/5] object-cover object-[50%_30%] rounded-xl border border-white/50 dark:border-neutral-800 shadow-md"
        />
      ))}
    </div>
    <div class="absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-neutral-50 dark:from-[#0a0a0a] to-transparent"></div>
  </div>

  <dl class="relative grid grid-cols-2 sm:grid-cols-4 border-t border-neutral-200 dark:border-neutral-800 divide-x divide-neutral-200 dark:divide-neutral-800">
    {stats.map(([value, label]) => (
      <div class="p-4 text-center">
        <dt class="sr-only">{label}</dt>
        <dd class="text-2xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white">{value}</dd>
        <dd class="text-[11px] font-mono text-neutral-500 mt-0.5" aria-hidden="true">{label}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .mosaic-drift {
      animation: mosaic-drift 40s linear infinite alternate;
    }
  }
  @keyframes mosaic-drift {
    from {
      translate: 0 0;
    }
    to {
      translate: -180px 0;
    }
  }
</style>
