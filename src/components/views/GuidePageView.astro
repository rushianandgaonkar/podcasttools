---
/**
 * Shared guide article page for every locale.
 * Used by src/pages/guides/[slug].astro (en) and src/pages/[lang]/guides/[slug].astro.
 */
import Layout from "../../layouts/Layout.astro";
import { siteConfig, toolRegistry, type GuideDefinition } from "../../config/site";
import type { SupportedLocale } from "../../i18n/languages";
import { getLocalizedPath } from "../../i18n/utils";
import { usePageCopy, fillTool } from "../../i18n/pageCopy";
import { getLocalizedGuide } from "../../i18n/guidesData";
import { getLocalizedTool } from "../../i18n/toolsData";
import { getGuideOgImage } from "../../lib/toolImages";
import GuideCover from "../brand/GuideCover.astro";
import { ToolIcon } from "../tools/ToolIcon";
import { Clock, ChevronRight, ArrowRight, CheckCircle2 } from "lucide-react";

interface Props {
  guide: GuideDefinition;
  lang: SupportedLocale;
}

const { guide, lang } = Astro.props;
const copy = usePageCopy(lang);
const locGuide = getLocalizedGuide(guide, lang);

const abs = (path: string) => `${siteConfig.url}${getLocalizedPath(path, lang)}`.replace(/\/$/, "");
const pageUrl = abs(`/guides/${guide.slug}`);
const ogImage = getGuideOgImage(guide.slug);

// Related tools: the guide's CTA tool first, then two more from the same category
const ctaTool = toolRegistry.find((x) => x.slug === locGuide.cta?.toolSlug);
const relatedTools = (ctaTool
  ? [ctaTool, ...toolRegistry.filter((x) => x.category === ctaTool.category && x.slug !== ctaTool.slug)]
  : toolRegistry.filter((x) => x.featured)
)
  .slice(0, 3)
  .map((x) => getLocalizedTool(x, lang));

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: locGuide.title,
  description: locGuide.description,
  inLanguage: lang,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  image: ogImage.startsWith("http") ? ogImage : `${siteConfig.url}${ogImage}`,
  datePublished: locGuide.publishedAt,
  dateModified: "2026-11-05",
  author: { "@type": "Organization", name: siteConfig.name, url: siteConfig.url },
  publisher: {
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.url,
    logo: { "@type": "ImageObject", url: `${siteConfig.url}/apple-touch-icon.png` },
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: copy.breadcrumbs.home, item: abs("/") },
    { "@type": "ListItem", position: 2, name: copy.breadcrumbs.guides, item: abs("/guides") },
    { "@type": "ListItem", position: 3, name: locGuide.title, item: pageUrl },
  ],
};

const faqSchema = locGuide.faqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      inLanguage: lang,
      mainEntity: locGuide.faqs.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    }
  : null;
---

<Layout
  title={locGuide.metaTitle ?? `${locGuide.title} | Pod Studio`}
  description={locGuide.description}
  lang={lang}
  canonicalUrl={pageUrl}
  ogImage={ogImage}
  ogImageAlt={locGuide.title}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <div class="w-full py-8 sm:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-neutral-500 font-mono">
        <a href={getLocalizedPath("/", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {copy.breadcrumbs.home}
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <a href={getLocalizedPath("/guides", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {copy.breadcrumbs.guides}
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <span class="text-neutral-900 dark:text-neutral-100 font-medium truncate" aria-current="page">{locGuide.title}</span>
      </nav>

      <!-- Header -->
      <div class="space-y-3 pb-6 border-b border-neutral-200 dark:border-neutral-800">
        <div class="flex items-center gap-2 text-xs">
          <span class="font-mono text-[10px] uppercase px-1.5 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400">
            {locGuide.category}
          </span>
          <span class="flex items-center gap-1 text-neutral-400 font-mono text-[11px]">
            <Clock className="w-3 h-3" />
            {locGuide.readTime}
          </span>
          <span class="text-neutral-400 font-mono text-[11px]">• {copy.guidePage.publishedLabel} <time datetime={locGuide.publishedAt}>{locGuide.publishedAt}</time></span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white leading-tight">
          {locGuide.title}
        </h1>

        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {locGuide.description}
        </p>

        <GuideCover slug={guide.slug} class="aspect-[2/1] sm:aspect-[5/2] mt-5" />
      </div>

      <!-- Localized Guide Content -->
      <article class="space-y-8 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
        {locGuide.sections.map((section) => (
          <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white">
              {section.heading}
            </h2>

            {section.paragraphs.map((p) => (
              <p>{p}</p>
            ))}

            {section.formula && (
              <div class="p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] font-mono text-xs text-[#0070f3]">
                {section.formula}
              </div>
            )}

            {section.cards && (
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                {section.cards.map((card) => (
                  <div class={`p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] ${card.highlight ? 'border-[#0070f3]/40' : ''}`}>
                    <span class={`font-mono text-[10px] uppercase block mb-1 ${card.highlight ? 'text-[#0070f3]' : 'text-neutral-400'}`}>
                      {card.title}
                    </span>
                    {card.value && (
                      <div class={`text-lg font-semibold ${card.highlight ? 'text-[#0070f3]' : 'text-neutral-900 dark:text-white'}`}>
                        {card.value}
                      </div>
                    )}
                    <p class="text-[11px] text-neutral-500 mt-1">
                      {card.description}
                    </p>
                  </div>
                ))}
              </div>
            )}

            {section.list && (
              <div class="space-y-2">
                {section.list.map((item) => (
                  <div class="flex items-start gap-2.5 p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                    <CheckCircle2 className="w-4 h-4 text-emerald-500 mt-0.5 flex-shrink-0" />
                    <div>
                      <strong class="text-neutral-900 dark:text-white font-semibold text-xs block mb-0.5">
                        {item.title}
                      </strong>
                      <p class="text-neutral-600 dark:text-neutral-400 text-xs">
                        {item.description}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </section>
        ))}

        <!-- Direct Tool CTA -->
        {locGuide.cta && (
          <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] flex flex-col sm:flex-row sm:items-center justify-between gap-4 mt-6">
            <div class="space-y-0.5">
              <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">
                {locGuide.cta.title}
              </h3>
              <p class="text-xs text-neutral-500">
                {locGuide.cta.description}
              </p>
            </div>
            <a
              href={getLocalizedPath(`/tools/${locGuide.cta.toolSlug}`, lang)}
              class="px-4 py-2 rounded-full bg-[#171717] dark:bg-white text-white dark:text-black font-medium text-xs inline-flex items-center gap-1.5 whitespace-nowrap self-start sm:self-auto hover:opacity-90 transition-opacity"
            >
              {locGuide.cta.buttonText} <ArrowRight className="w-3.5 h-3.5" />
            </a>
          </div>
        )}

        <!-- Guide FAQ -->
        {locGuide.faqs && locGuide.faqs.length > 0 && (
          <section class="space-y-3 pt-6 border-t border-neutral-200 dark:border-neutral-800">
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white">
              {copy.guidePage.faqHeading}
            </h2>
            {locGuide.faqs.map((faq) => (
              <details class="group rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] p-4 transition-all">
                <summary class="flex items-center justify-between font-medium text-xs sm:text-sm text-neutral-900 dark:text-white cursor-pointer list-none">
                  <span>{faq.question}</span>
                  <span class="text-neutral-400 group-open:rotate-180 transition-transform" aria-hidden="true">▼</span>
                </summary>
                <div class="pt-3 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed border-t border-neutral-100 dark:border-neutral-900 mt-3">
                  {faq.answer}
                </div>
              </details>
            ))}
          </section>
        )}

        <!-- Related tools (internal links from guide to tool landing pages) -->
        <section class="space-y-3 pt-6 border-t border-neutral-200 dark:border-neutral-800">
          <h2 class="text-lg font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white">
            {copy.guidePage.relatedToolsHeading}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            {relatedTools.map((relTool) => (
              <a
                href={getLocalizedPath(`/tools/${relTool.slug}`, lang)}
                class="group p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors flex flex-col justify-between"
              >
                <div class="flex items-center gap-2 mb-2">
                  <div class="w-6 h-6 rounded bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center text-neutral-700 dark:text-neutral-300">
                    <ToolIcon name={relTool.icon} className="w-3.5 h-3.5" />
                  </div>
                  <span class="text-xs font-semibold text-neutral-900 dark:text-white group-hover:text-[#0070f3] transition-colors">
                    {relTool.shortTitle}
                  </span>
                </div>
                <p class="text-xs text-neutral-500 line-clamp-2 mb-3">{relTool.description}</p>
                <span class="text-xs font-medium text-[#0070f3] inline-flex items-center gap-1">
                  {fillTool(copy.toolPage.openTool, relTool.shortTitle)}
                  <ArrowRight className="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
                </span>
              </a>
            ))}
          </div>
        </section>
      </article>
    </div>
  </div>
</Layout>
