---
/**
 * Shared /guides index for every locale.
 */
import Layout from "../../layouts/Layout.astro";
import { siteConfig, guidesRegistry } from "../../config/site";
import type { SupportedLocale } from "../../i18n/languages";
import { getLocalizedPath } from "../../i18n/utils";
import { usePageCopy } from "../../i18n/pageCopy";
import { getLocalizedGuide } from "../../i18n/guidesData";
import GuideCover from "../brand/GuideCover.astro";
import { BookOpen, Clock, ArrowRight } from "lucide-react";

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const copy = usePageCopy(lang);
const pageUrl = `${siteConfig.url}${getLocalizedPath("/guides", lang)}`;

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: copy.guidesIndex.heading,
  itemListElement: guidesRegistry.map((guide, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: getLocalizedGuide(guide, lang).title,
    url: `${siteConfig.url}${getLocalizedPath(`/guides/${guide.slug}`, lang)}`,
  })),
};
---

<Layout
  title={copy.meta.guidesTitle}
  description={copy.meta.guidesDescription}
  lang={lang}
  canonicalUrl={pageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <div class="w-full py-10 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-10">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 font-mono text-[11px]">
          <BookOpen className="w-3 h-3 text-[#a9583e]" />
          {copy.guidesIndex.eyebrow}
        </div>
        <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white">
          {copy.guidesIndex.heading}
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl">
          {copy.guidesIndex.intro}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {guidesRegistry.map((guide) => {
          const loc = getLocalizedGuide(guide, lang);
          return (
            <a
              href={getLocalizedPath(`/guides/${guide.slug}`, lang)}
              class="group p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors flex flex-col justify-between"
            >
              <div>
                <GuideCover slug={guide.slug} class="aspect-[2/1] mb-4 -mt-1" />
                <div class="flex items-center justify-between text-xs text-neutral-400 mb-2.5">
                  <span class="font-mono text-[10px] uppercase px-1.5 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400">
                    {loc.category}
                  </span>
                  <span class="flex items-center gap-1 font-mono text-[10px]">
                    <Clock className="w-3 h-3" />
                    {loc.readTime}
                  </span>
                </div>
                <h2 class="text-sm font-semibold text-neutral-900 dark:text-white group-hover:text-[#a9583e] dark:group-hover:text-[#a9583e] transition-colors mb-1.5">
                  {loc.title}
                </h2>
                <p class="text-xs text-neutral-500 leading-relaxed line-clamp-3 mb-4">
                  {loc.description}
                </p>
              </div>

              <div class="pt-3 border-t border-neutral-100 dark:border-neutral-900 text-xs font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-[#a9583e] inline-flex items-center gap-1">
                {copy.guidesIndex.readGuide} <ArrowRight className="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</Layout>
