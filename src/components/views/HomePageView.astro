---
/**
 * Shared homepage for every locale (used by src/pages/index.astro and src/pages/[lang]/index.astro).
 */
import Layout from "../../layouts/Layout.astro";
import { siteConfig, guidesRegistry } from "../../config/site";
import { HeroQuickTool } from "../home/HeroQuickTool";
import { HomeToolGrid } from "../home/HomeToolGrid";
import HowItWorks from "../home/HowItWorks.astro";
import type { SupportedLocale } from "../../i18n/languages";
import { useTranslations, getLocalizedPath } from "../../i18n/utils";
import { usePageCopy } from "../../i18n/pageCopy";
import { getLocalizedGuide } from "../../i18n/guidesData";
import GuideCover from "../brand/GuideCover.astro";
import {
  Sparkles,
  ShieldCheck,
  Layers,
  Zap,
  ArrowRight,
  Clock,
  ArrowUpRight,
} from "lucide-react";

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = usePageCopy(lang);
// The homepage shows a short selection; the full list lives on /guides.
const HOME_GUIDE_LIMIT = 6;
const homeGuides = guidesRegistry.slice(0, HOME_GUIDE_LIMIT);
const homeUrl = `${siteConfig.url}${getLocalizedPath("/", lang)}`.replace(/\/$/, "");

// FAQ Schema.org Structured Data
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: t.faq.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<Layout
  title={copy.meta.homeTitle}
  description={copy.meta.homeDescription}
  lang={lang}
  canonicalUrl={homeUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="flex flex-col items-center w-full">
    <!-- Hero: copy on the left, the live "studio console" demo on the right -->
    <section class="studio-hero w-full relative pt-12 pb-16 md:pt-20 md:pb-20 overflow-hidden border-b border-neutral-200 dark:border-neutral-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 flex flex-col items-center">
        <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] gap-10 lg:gap-14 items-center w-full">
          <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
            <p class="inline-flex items-center gap-2 text-xs sm:text-[13px] text-neutral-600 dark:text-neutral-400 mb-5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
              <span>{t.hero.badge}</span>
            </p>

            <h1 class="font-display text-[2.1rem] sm:text-5xl lg:text-[3.4rem] font-semibold tracking-[-0.035em] text-neutral-900 dark:text-white max-w-xl leading-[1.05] mb-5 text-balance">
              {t.hero.titleStart}{lang === "ja" ? "" : " "}{t.hero.titleHighlight}
            </h1>

            <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 max-w-xl leading-relaxed mb-8">
              {t.hero.description}
            </p>

            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3">
              <a
                href="#tools-section"
                class="px-5 py-2.5 rounded-full bg-[#a9583e] hover:bg-[#8f4630] text-white font-medium text-sm transition-colors flex items-center gap-2 shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#a9583e]"
              >
                {t.hero.primaryCta}
                <ArrowRight className="w-3.5 h-3.5" />
              </a>

              <a
                href={getLocalizedPath("/tools/monetization-calculator", lang)}
                class="px-5 py-2.5 rounded-full bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-50 dark:hover:bg-neutral-800 font-medium text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#a9583e]"
              >
                {t.hero.secondaryCta}
              </a>
            </div>
          </div>

          <!-- Interactive Hero Quick Tool Island: live demo beside the copy -->
          <div class="w-full">
            <HeroQuickTool client:load lang={lang} />
          </div>
        </div>

        <!-- Trust row: one quiet line of facts instead of four boxed cards -->
        <dl class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-5 w-full mt-14 pt-6 border-t border-neutral-200 dark:border-neutral-800 text-left">
          <div class="flex items-start gap-2.5">
            <Sparkles className="w-4 h-4 mt-0.5 shrink-0 text-[#a9583e]" />
            <div>
              <dt class="text-sm font-medium text-neutral-900 dark:text-white">{t.nav.allTools}</dt>
              <dd class="text-xs text-neutral-500">{copy.home.trustToolsSub}</dd>
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <ShieldCheck className="w-4 h-4 mt-0.5 shrink-0 text-[#a9583e]" />
            <div>
              <dt class="text-sm font-medium text-neutral-900 dark:text-white">{t.hero.trustPills.privacy}</dt>
              <dd class="text-xs text-neutral-500">{copy.home.trustPrivacySub}</dd>
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <Layers className="w-4 h-4 mt-0.5 shrink-0 text-[#a9583e]" />
            <div>
              <dt class="text-sm font-medium text-neutral-900 dark:text-white">{t.hero.trustPills.free}</dt>
              <dd class="text-xs text-neutral-500">{copy.home.trustFreeSub}</dd>
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <Zap className="w-4 h-4 mt-0.5 shrink-0 text-[#a9583e]" />
            <div>
              <dt class="text-sm font-medium text-neutral-900 dark:text-white">{t.hero.trustPills.formulas}</dt>
              <dd class="text-xs text-neutral-500">{copy.home.trustSpecSub}</dd>
            </div>
          </div>
        </dl>
      </div>
    </section>

    <!-- Main Tools Directory Section -->
    <section class="w-full py-16 sm:py-20 max-w-6xl mx-auto px-4 sm:px-6" id="tools-section">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-3">
        <div>
          <span class="font-mono text-xs uppercase tracking-wider text-neutral-500 block mb-1">
            {copy.home.toolsEyebrow}
          </span>
          <h2 class="font-display text-2xl sm:text-3xl font-semibold tracking-[-0.025em] text-neutral-900 dark:text-white">
            {t.toolsSection.title}
          </h2>
        </div>
        <p class="text-xs text-neutral-500 max-w-xs sm:text-right">
          {t.toolsSection.subtitle}
        </p>
      </div>

      <!-- Interactive Tool Grid Island -->
      <HomeToolGrid client:load lang={lang} labels={copy.grid} defaultView="grid" />
    </section>

    <!-- How It Works (3-step visual strip) -->
    <HowItWorks lang={lang} />

    <!-- Educational Playbooks Section -->
    <section class="w-full py-16 sm:py-20 border-t border-neutral-200 dark:border-neutral-800 max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-3">
        <div>
          <span class="font-mono text-xs uppercase tracking-wider text-neutral-500 block mb-1">
            {copy.home.guidesEyebrow}
          </span>
          <h2 class="font-display text-2xl sm:text-3xl font-semibold tracking-[-0.025em] text-neutral-900 dark:text-white">
            {copy.home.guidesHeading}
          </h2>
        </div>
        <a href={getLocalizedPath("/guides", lang)} class="text-xs font-medium text-[#a9583e] hover:underline inline-flex items-center gap-1">
          {t.nav.guides} ({guidesRegistry.length}) <ArrowUpRight className="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {homeGuides.map((guide) => {
          const loc = getLocalizedGuide(guide, lang);
          return (
            <a
              href={getLocalizedPath(`/guides/${guide.slug}`, lang)}
              class="group rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1f1e1b] p-5 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors flex flex-col justify-between"
            >
              <div>
                <GuideCover slug={guide.slug} class="aspect-[2/1] mb-4 -mt-1" />
                <div class="flex items-center justify-between text-xs text-neutral-400 mb-2.5">
                  <span class="font-mono text-[10px] uppercase px-1.5 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400">
                    {loc.category}
                  </span>
                  <span class="flex items-center gap-1 text-[11px] font-mono">
                    <Clock className="w-3 h-3" />
                    {loc.readTime}
                  </span>
                </div>
                <h3 class="text-sm font-semibold text-neutral-900 dark:text-white group-hover:text-[#a9583e] dark:group-hover:text-[#a9583e] transition-colors mb-1.5">
                  {loc.title}
                </h3>
                <p class="text-xs text-neutral-500 leading-relaxed line-clamp-2 mb-4">
                  {loc.description}
                </p>
              </div>
              <div class="text-xs font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-[#a9583e] inline-flex items-center gap-1">
                {copy.guidesIndex.readGuide} <ArrowRight className="w-3.5 h-3.5" />
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Prerendered Localized HTML FAQ Accordion -->
    <section class="w-full py-16 sm:py-20 border-t border-neutral-200 dark:border-neutral-800 bg-neutral-100/30 dark:bg-neutral-950/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
          <span class="font-mono text-xs uppercase tracking-wider text-neutral-500 block mb-1">
            {t.faq.eyebrow}
          </span>
          <h2 class="font-display text-2xl sm:text-3xl font-semibold tracking-[-0.025em] text-neutral-900 dark:text-white mb-2">
            {t.faq.title}
          </h2>
          <p class="text-xs sm:text-sm text-neutral-500">
            {t.faq.subtitle}
          </p>
        </div>

        <div class="space-y-3">
          {t.faq.items.map((item) => (
            <details class="group rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1f1e1b] p-4 transition-all">
              <summary class="flex items-center justify-between font-medium text-xs sm:text-sm text-neutral-900 dark:text-white cursor-pointer list-none">
                <span>{item.question}</span>
                <svg class="w-4 h-4 shrink-0 text-neutral-400 group-open:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </summary>
              <div class="pt-3 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed border-t border-neutral-100 dark:border-neutral-900 mt-3">
                {item.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
