---
/**
 * Shared tool landing page for every locale.
 * Used by src/pages/tools/[slug].astro (en) and src/pages/[lang]/tools/[slug].astro.
 * Keeping one template guarantees the English and localized pages never drift apart.
 */
import Layout from "../../layouts/Layout.astro";
import { siteConfig, toolRegistry, toolCategories, type ToolDefinition } from "../../config/site";
import { ToolDispatcher } from "../tools/ToolDispatcher";
import { ToolIcon } from "../tools/ToolIcon";
import type { SupportedLocale } from "../../i18n/languages";
import { useTranslations, getLocalizedPath } from "../../i18n/utils";
import { usePageCopy, fillTool } from "../../i18n/pageCopy";
import { getLocalizedTool } from "../../i18n/toolsData";
import { getLocalizedToolFaqs } from "../../i18n/toolFaqs";
import { getToolContent } from "../../i18n/toolContent";
import { getToolImage, getToolOgImage } from "../../lib/toolImages";
import { ShieldCheck, Zap, ArrowRight, ChevronRight, Lightbulb } from "lucide-react";

interface Props {
  tool: ToolDefinition;
  lang: SupportedLocale;
}

const { tool: rawTool, lang } = Astro.props;
const t = useTranslations(lang);
const copy = usePageCopy(lang);
const tool = getLocalizedTool(rawTool, lang);
const content = getToolContent(rawTool.slug, lang);
const toolFaqs = getLocalizedToolFaqs(tool.slug, lang);
const toolImage = getToolImage(rawTool.image);
const toolAccent = toolCategories.find((c) => c.id === rawTool.category)?.accent ?? "#7c3aed";

const abs = (path: string) => `${siteConfig.url}${getLocalizedPath(path, lang)}`.replace(/\/$/, "") || siteConfig.url;
const pageUrl = abs(`/tools/${tool.slug}`);

// Related tools: same category first, then featured tools, max 3
const sameCategory = toolRegistry.filter((x) => x.slug !== rawTool.slug && x.category === rawTool.category);
const featuredOthers = toolRegistry.filter(
  (x) => x.slug !== rawTool.slug && x.category !== rawTool.category && x.featured,
);
const relatedTools = [...sameCategory, ...featuredOthers].slice(0, 3).map((rel) => getLocalizedTool(rel, lang));

const metaTitle = content?.metaTitle ?? `${tool.title} | Pod Studio`;
const metaDescription = content?.metaDescription ?? tool.description;

// Structured data
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: tool.title,
  alternateName: tool.shortTitle,
  url: pageUrl,
  image: `${siteConfig.url}${rawTool.image}`,
  inLanguage: lang,
  description: metaDescription,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any (web browser)",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  provider: {
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.url,
  },
  browserRequirements: "Requires JavaScript",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: copy.breadcrumbs.home, item: abs("/") },
    { "@type": "ListItem", position: 2, name: copy.breadcrumbs.tools, item: abs("/tools") },
    { "@type": "ListItem", position: 3, name: tool.shortTitle, item: pageUrl },
  ],
};

const toolFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: toolFaqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout
  title={metaTitle}
  description={metaDescription}
  lang={lang}
  canonicalUrl={pageUrl}
  ogImage={getToolOgImage(tool.slug)}
  ogImageAlt={tool.title}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {toolFaqs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(toolFaqSchema)} />}

  <div class="w-full py-8 sm:py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-8">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-neutral-500 font-mono">
        <a href={getLocalizedPath("/", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {copy.breadcrumbs.home}
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <a href={getLocalizedPath("/tools", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {copy.breadcrumbs.tools}
        </a>
        <ChevronRight className="w-3 h-3 text-neutral-400" />
        <span class="text-neutral-900 dark:text-neutral-100 font-medium truncate" aria-current="page">{tool.shortTitle}</span>
      </nav>

      <!-- Tool Header + Illustration -->
      <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_200px] lg:grid-cols-[minmax(0,1fr)_232px] gap-6 lg:gap-10 items-center">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-[10px] uppercase font-medium tracking-wider px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400">
              {tool.categoryLabel}
            </span>
            {tool.badge && (
              <span class="font-mono text-[10px] uppercase font-semibold tracking-wider px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 bg-[#171717] dark:bg-white text-white dark:text-black">
                {tool.badge}
              </span>
            )}
            <div class="inline-flex items-center gap-1 text-[10px] font-mono text-emerald-600 dark:text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/20 bg-emerald-500/5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> {copy.toolPage.privacyBadge}
            </div>
          </div>

          <h1 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white leading-tight">
            {tool.title}
          </h1>

          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-3xl">
            {tool.longDescription}
          </p>

          <div class="flex flex-wrap items-center gap-2 pt-1">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 text-[11px] font-mono">
              <ShieldCheck className="w-3.5 h-3.5 text-emerald-500" />
              <span>{t.toolSteps.clientMemoryBadge}</span>
            </div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 text-[11px] font-mono">
              <Zap className="w-3.5 h-3.5 text-amber-500" />
              <span>{t.toolSteps.specVerifiedBadge}</span>
            </div>
          </div>
        </div>

        <!-- Tool illustration (decorative; hidden on small screens so the tool stays above the fold) -->
        <figure class="hidden md:block relative" aria-hidden="true">
          <div class="absolute -inset-4 rounded-[28px] opacity-60 blur-2xl" style={`background: radial-gradient(closest-side, ${toolAccent}55, transparent)`}></div>
          <picture>
            <source media="(min-width: 768px)" srcset={toolImage.srcSet} sizes="(min-width: 1024px) 232px, 200px" type="image/webp" />
            <img
              src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
              width={toolImage.width}
              height={toolImage.height}
              alt=""
              decoding="async"
              class="relative w-full aspect-[4/5] object-cover object-[50%_30%] rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-lg rotate-[2deg] hover:rotate-0 transition-transform duration-300"
            />
          </picture>
        </figure>
      </div>

      <!-- Primary Interactive Tool Workspace (React Island) -->
      <div class="pt-2 tool-workspace">
        <ToolDispatcher slug={tool.slug} lang={lang} client:load />
      </div>

      <!-- Tool-specific landing content (unique per tool and per locale) -->
      <section class="border-t border-neutral-200 dark:border-neutral-800 pt-10 space-y-10">
        {content && (
          <div class="space-y-3 max-w-3xl">
            <h2 class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white">
              {fillTool(copy.toolPage.overviewHeading, tool.shortTitle)}
            </h2>
            {content.overview.map((p) => (
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">{p}</p>
            ))}
          </div>
        )}

        <div>
          <h2 class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white mb-4">
            {content ? copy.toolPage.stepsHeading : t.toolDetail.howToUse}
          </h2>
          {content ? (
            <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 list-none p-0 m-0">
              {content.steps.map((step, i) => (
                <li class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                  <span class="font-mono text-xs font-semibold text-[#0070f3] block mb-1">
                    {String(i + 1).padStart(2, "0")} · {step.title}
                  </span>
                  <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">{step.text}</p>
                </li>
              ))}
            </ol>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                <span class="font-mono text-xs font-semibold text-[#0070f3] block mb-1">{t.toolSteps.step1Title}</span>
                <p class="text-xs text-neutral-600 dark:text-neutral-400">{t.toolSteps.step1Desc}</p>
              </div>
              <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                <span class="font-mono text-xs font-semibold text-[#0070f3] block mb-1">{t.toolSteps.step2Title}</span>
                <p class="text-xs text-neutral-600 dark:text-neutral-400">{t.toolSteps.step2Desc}</p>
              </div>
              <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a]">
                <span class="font-mono text-xs font-semibold text-[#0070f3] block mb-1">{t.toolSteps.step3Title}</span>
                <p class="text-xs text-neutral-600 dark:text-neutral-400">{t.toolSteps.step3Desc}</p>
              </div>
            </div>
          )}
        </div>

        {content && (
          <div>
            <h2 class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white mb-4">
              {copy.toolPage.tipsHeading}
            </h2>
            <ul class="space-y-2 max-w-3xl">
              {content.tips.map((tip) => (
                <li class="flex items-start gap-2.5 p-3.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
                  <Lightbulb className="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0" />
                  <span>{tip}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Related Tools -->
        <div>
          <h2 class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white mb-4">
            {t.toolDetail.relatedTools}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {relatedTools.map((relTool) => (
              <a
                href={getLocalizedPath(`/tools/${relTool.slug}`, lang)}
                class="group p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <div class="w-6 h-6 rounded bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center text-neutral-700 dark:text-neutral-300">
                      <ToolIcon name={relTool.icon} className="w-3.5 h-3.5" />
                    </div>
                    <span class="text-xs font-semibold text-neutral-900 dark:text-white group-hover:text-[#0070f3] transition-colors">
                      {relTool.shortTitle}
                    </span>
                  </div>
                  <p class="text-xs text-neutral-500 line-clamp-2 mb-3">{relTool.description}</p>
                </div>
                <span class="text-xs font-medium text-[#0070f3] inline-flex items-center gap-1">
                  {fillTool(copy.toolPage.openTool, relTool.shortTitle)}
                  <ArrowRight className="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
                </span>
              </a>
            ))}
          </div>
        </div>

        <!-- Tool FAQ Accordion -->
        {toolFaqs.length > 0 && (
          <div class="pt-6 border-t border-neutral-200 dark:border-neutral-800">
            <h2 class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-neutral-900 dark:text-white mb-2">
              {t.toolDetail.faqs}
            </h2>
            <p class="text-xs text-neutral-500 mb-4">{t.faq.subtitle}</p>
            <div class="space-y-3">
              {toolFaqs.map((faq) => (
                <details class="group rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] p-4 transition-all">
                  <summary class="flex items-center justify-between font-medium text-xs sm:text-sm text-neutral-900 dark:text-white cursor-pointer list-none">
                    <span>{faq.question}</span>
                    <span class="text-neutral-400 group-open:rotate-180 transition-transform" aria-hidden="true">▼</span>
                  </summary>
                  <div class="pt-3 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed border-t border-neutral-100 dark:border-neutral-900 mt-3">
                    {faq.answer}
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}
      </section>
    </div>
  </div>
</Layout>
