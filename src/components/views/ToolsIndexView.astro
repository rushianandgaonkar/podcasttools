---
/**
 * Shared /tools directory page for every locale.
 */
import Layout from "../../layouts/Layout.astro";
import { siteConfig, toolRegistry } from "../../config/site";
import { HomeToolGrid } from "../home/HomeToolGrid";
import type { SupportedLocale } from "../../i18n/languages";
import { getLocalizedPath } from "../../i18n/utils";
import { usePageCopy } from "../../i18n/pageCopy";
import { getLocalizedTool } from "../../i18n/toolsData";
import { Sparkles } from "lucide-react";

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const copy = usePageCopy(lang);
const pageUrl = `${siteConfig.url}${getLocalizedPath("/tools", lang)}`;

// ItemList lets search engines understand this page as a directory of the 20 tools
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: copy.toolsIndex.heading,
  numberOfItems: toolRegistry.length,
  itemListElement: toolRegistry.map((tool, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: getLocalizedTool(tool, lang).title,
    url: `${siteConfig.url}${getLocalizedPath(`/tools/${tool.slug}`, lang)}`,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: copy.breadcrumbs.home, item: `${siteConfig.url}${getLocalizedPath("/", lang)}`.replace(/\/$/, "") },
    { "@type": "ListItem", position: 2, name: copy.breadcrumbs.tools, item: pageUrl },
  ],
};
---

<Layout
  title={copy.meta.toolsTitle}
  description={copy.meta.toolsDescription}
  lang={lang}
  canonicalUrl={pageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="w-full py-10 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-2xl mb-10">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1f1e1b] text-neutral-600 dark:text-neutral-400 font-mono text-[11px] mb-3 uppercase">
          <Sparkles className="w-3 h-3 text-[#a9583e]" />
          {copy.toolsIndex.eyebrow}
        </div>
        <h1 class="font-display text-3xl sm:text-[2.6rem] font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white mb-3">
          {copy.toolsIndex.heading}
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {copy.toolsIndex.intro}
        </p>
      </div>

      <HomeToolGrid client:load lang={lang} labels={copy.grid} />
    </div>
  </div>
</Layout>
