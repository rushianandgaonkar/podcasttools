---
import { Logo } from "../brand/Logo";
import { LanguageSelector } from "./LanguageSelector";
import { defaultLocale, type SupportedLocale } from "../../i18n/languages";
import { useTranslations, getLocalizedPath } from "../../i18n/utils";
import { toolsData } from "../../i18n/toolsData";

interface Props {
  lang?: SupportedLocale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const getToolName = (slug: string) =>
  toolsData[lang]?.[slug]?.shortTitle || toolsData.en[slug]?.shortTitle || slug;
---

<footer class="w-full border-t border-neutral-200 dark:border-[#222222] bg-[#fafafa] dark:bg-[#000000] text-neutral-600 dark:text-neutral-400 text-xs transition-colors duration-150">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Top Grid: Brand & Categorized Links -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 pb-10 border-b border-neutral-200 dark:border-[#222222]">
      <!-- Brand Summary -->
      <div class="col-span-2 space-y-3">
        <a href={getLocalizedPath("/", lang)} class="inline-block">
          <Logo size="md" />
        </a>
        <p class="text-xs text-neutral-500 leading-relaxed max-w-sm">
          {t.footer.tagline}
        </p>

        <!-- Privacy Status Badge -->
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] text-neutral-600 dark:text-neutral-400 text-[11px] font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>{t.footer.privacyBadge}</span>
        </div>
      </div>

      <!-- Column 1: Ideation -->
      <div class="space-y-2.5">
        <h3 class="font-mono text-[11px] uppercase tracking-wider text-neutral-900 dark:text-neutral-200 font-semibold">
          {t.nav.ideation}
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={getLocalizedPath("/tools/episode-title-generator", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("episode-title-generator")}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath("/tools/podcast-name-generator", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("podcast-name-generator")}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath("/tools/guest-question-generator", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("guest-question-generator")}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath("/tools/hook-generator", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("hook-generator")}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Content -->
      <div class="space-y-2.5">
        <h3 class="font-mono text-[11px] uppercase tracking-wider text-neutral-900 dark:text-neutral-200 font-semibold">
          {t.nav.content}
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={getLocalizedPath("/tools/show-notes-generator", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("show-notes-generator")}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath("/tools/episode-outline-builder", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("episode-outline-builder")}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath("/tools/intro-script-generator", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("intro-script-generator")}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath("/tools/transcript-formatter", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("transcript-formatter")}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Tech & Growth -->
      <div class="space-y-2.5">
        <h3 class="font-mono text-[11px] uppercase tracking-wider text-neutral-900 dark:text-neutral-200 font-semibold">
          {t.nav.technical} &amp; {t.nav.growth}
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={getLocalizedPath("/tools/monetization-calculator", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("monetization-calculator")}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath("/tools/cover-art-preview", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("cover-art-preview")}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath("/tools/rss-feed-validator", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("rss-feed-validator")}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath("/tools/audience-growth-estimator", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
              {getToolName("audience-growth-estimator")}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500">
      <div class="flex items-center gap-2">
        <span>&copy; {currentYear} Pod Studio. Designed with the Geist design system.</span>
      </div>

      <!-- Footer Language Selector & Legal Links -->
      <div class="flex flex-wrap items-center gap-4">
        <LanguageSelector client:visible currentLang={lang} variant="footer" />
        <a href={getLocalizedPath("/about", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.about}
        </a>
        <a href={getLocalizedPath("/contact", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.contact}
        </a>
        <a href={getLocalizedPath("/privacy", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.privacy}
        </a>
        <a href={getLocalizedPath("/terms", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.terms}
        </a>
        <a href={getLocalizedPath("/guides", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.guides}
        </a>
      </div>
    </div>
  </div>
</footer>
