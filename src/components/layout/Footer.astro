---
import { Logo } from "../brand/Logo";
import { ShieldCheck } from "lucide-react";
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-studio-border/60 bg-[#070712] text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <!-- Top Section: Brand + Category Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 pb-12 border-b border-studio-border/60">
      <!-- Brand Info -->
      <div class="lg:col-span-2 space-y-4">
        <Logo size="md" />
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          The free, all-in-one creator toolkit for podcasters. Generate episode titles, format show notes, calculate sponsorship revenue, and preview Apple/Spotify artwork.
        </p>

        <!-- Privacy Promise Callout -->
        <div class="p-3.5 rounded-xl bg-studio-card border border-studio-border/80 flex items-start gap-3 max-w-sm">
          <ShieldCheck className="w-5 h-5 text-emerald-400 flex-shrink-0 mt-0.5" />
          <div class="text-xs space-y-1">
            <span class="font-semibold text-slate-200 block">
              100% Client-Side Privacy Guarantee
            </span>
            <p class="text-slate-400">
              Zero audio files, scripts, or personal notes are uploaded to external servers. Everything computes locally in your browser.
            </p>
          </div>
        </div>
      </div>

      <!-- Column 1: Ideation & Branding -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300">
          Ideation &amp; Branding
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/tools/episode-title-generator" class="hover:text-orange-400 transition-colors">
              Episode Title Generator
            </a>
          </li>
          <li>
            <a href="/tools/podcast-name-generator" class="hover:text-orange-400 transition-colors">
              Podcast Name Generator
            </a>
          </li>
          <li>
            <a href="/tools/guest-question-generator" class="hover:text-orange-400 transition-colors">
              Guest Question Generator
            </a>
          </li>
          <li>
            <a href="/tools/hook-generator" class="hover:text-orange-400 transition-colors">
              Hook &amp; Cold Open Generator
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Content & Production -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300">
          Content &amp; Scripts
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/tools/show-notes-generator" class="hover:text-orange-400 transition-colors">
              Show Notes Generator
            </a>
          </li>
          <li>
            <a href="/tools/episode-outline-builder" class="hover:text-orange-400 transition-colors">
              Episode Outline Builder
            </a>
          </li>
          <li>
            <a href="/tools/intro-script-generator" class="hover:text-orange-400 transition-colors">
              Intro Script Generator
            </a>
          </li>
          <li>
            <a href="/tools/description-generator" class="hover:text-orange-400 transition-colors">
              Description Generator
            </a>
          </li>
          <li>
            <a href="/tools/transcript-formatter" class="hover:text-orange-400 transition-colors">
              Transcript Formatter
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Tech & Growth -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300">
          Tech &amp; Analytics
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/tools/monetization-calculator" class="hover:text-orange-400 transition-colors">
              Sponsorship CPM Calculator
            </a>
          </li>
          <li>
            <a href="/tools/cover-art-preview" class="hover:text-orange-400 transition-colors">
              Cover Art Preview &amp; Specs
            </a>
          </li>
          <li>
            <a href="/tools/rss-feed-validator" class="hover:text-orange-400 transition-colors">
              RSS Feed Validator
            </a>
          </li>
          <li>
            <a href="/tools/episode-timestamp-generator" class="hover:text-orange-400 transition-colors">
              Timestamp Generator
            </a>
          </li>
          <li>
            <a href="/tools/category-finder" class="hover:text-orange-400 transition-colors">
              Category Finder (Apple/Spotify)
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Section: Legal & Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div class="flex items-center gap-2">
        <span>&copy; {currentYear} Pod Studio. Built for podcast creators worldwide.</span>
      </div>

      <div class="flex items-center gap-6">
        <a href="/about" class="hover:text-slate-200 transition-colors">
          About
        </a>
        <a href="/contact" class="hover:text-slate-200 transition-colors">
          Contact
        </a>
        <a href="/privacy" class="hover:text-slate-200 transition-colors">
          Privacy Policy
        </a>
        <a href="/terms" class="hover:text-slate-200 transition-colors">
          Terms of Use
        </a>
        <a href="/guides" class="hover:text-slate-200 transition-colors">
          Guides
        </a>
      </div>
    </div>
  </div>
</footer>
