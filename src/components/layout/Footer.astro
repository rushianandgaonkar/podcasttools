---
import { Logo } from "../brand/Logo";
import { LanguageSelector } from "./LanguageSelector";
import { defaultLocale, type SupportedLocale } from "../../i18n/languages";
import { useTranslations, getLocalizedPath } from "../../i18n/utils";
import { toolsData } from "../../i18n/toolsData";
import { usePageCopy } from "../../i18n/pageCopy";
import { toolRegistry } from "../../config/site";

interface Props {
  lang?: SupportedLocale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const copy = usePageCopy(lang);
const currentYear = new Date().getFullYear();

const getToolName = (slug: string) =>
  toolsData[lang]?.[slug]?.shortTitle || toolsData.en[slug]?.shortTitle || slug;

const footerColumns = [
  { id: "ideation", label: t.nav.ideation },
  { id: "content", label: t.nav.content },
  { id: "technical", label: t.nav.technical },
  { id: "growth", label: t.nav.growth },
].map((col) => ({ ...col, tools: toolRegistry.filter((tool) => tool.category === col.id) }));
---

<footer class="w-full border-t border-neutral-200 dark:border-[#222222] bg-[#faf9f5] dark:bg-[#181715] text-neutral-600 dark:text-neutral-400 text-xs transition-colors duration-150">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Top Grid: Brand & Categorized Links -->
    <div class="grid grid-cols-2 md:grid-cols-6 gap-8 pb-10 border-b border-neutral-200 dark:border-[#222222]">
      <!-- Brand Summary -->
      <div class="col-span-2 space-y-3">
        <a href={getLocalizedPath("/", lang)} class="inline-block">
          <Logo size="md" />
        </a>
        <p class="text-xs text-neutral-500 leading-relaxed max-w-sm">
          {t.footer.tagline}
        </p>

        <!-- Privacy Status Badge -->
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1f1e1b] text-neutral-600 dark:text-neutral-400 text-[11px] font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>{t.footer.privacyBadge}</span>
        </div>
      </div>

      <!-- One column per tool category: links to all 20 tools -->
      {footerColumns.map((col) => (
        <div class="space-y-2.5">
          <h3 class="font-mono text-[11px] uppercase tracking-wider text-neutral-900 dark:text-neutral-200 font-semibold">
            {col.label}
          </h3>
          <ul class="space-y-2 text-xs">
            {col.tools.map((tool) => (
              <li>
                <a href={getLocalizedPath(`/tools/${tool.slug}`, lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
                  {getToolName(tool.slug)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500">
      <div class="flex items-center gap-2">
        <span>&copy; {currentYear} Pod Studio. {copy.footer.rights}</span>
      </div>

      <!-- Footer Language Selector & Legal Links -->
      <div class="flex flex-wrap items-center gap-4">
        <LanguageSelector client:visible currentLang={lang} variant="footer" />
        <a href={getLocalizedPath("/about", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.about}
        </a>
        <a href={getLocalizedPath("/contact", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.contact}
        </a>
        <a href={getLocalizedPath("/privacy", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.privacy}
        </a>
        <a href={getLocalizedPath("/terms", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.terms}
        </a>
        <a href={getLocalizedPath("/guides", lang)} class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {t.nav.guides}
        </a>
      </div>
    </div>
  </div>
</footer>
