---
/**
 * Decorative floating illustration cards that flank the hero quick-tool on wide screens.
 * Hidden below xl; the <picture> media query means phones/tablets download nothing.
 */
import { toolRegistry } from "../../config/site";
import { getToolImage } from "../../lib/toolImages";

const pick = (slug: string) => {
  const tool = toolRegistry.find((t) => t.slug === slug)!;
  return getToolImage(tool.image);
};

const cards = [
  { img: pick("episode-title-generator"), cls: "-left-12 top-6 -rotate-6 w-[150px]" },
  { img: pick("podcast-name-generator"), cls: "-left-2 top-[236px] rotate-3 w-[124px] opacity-90" },
  { img: pick("monetization-calculator"), cls: "-right-12 top-2 rotate-6 w-[150px]" },
  { img: pick("cover-art-preview"), cls: "-right-2 top-[228px] -rotate-3 w-[124px] opacity-90" },
];
---

<div class="pointer-events-none absolute inset-0 hidden xl:block" aria-hidden="true">
  {cards.map(({ img, cls }) => (
    <picture>
      <source media="(min-width: 1280px)" srcset={img.srcSet} sizes="150px" type="image/webp" />
      <img
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        width={img.width}
        height={img.height}
        alt=""
        decoding="async"
        class={`absolute aspect-[4/5] object-cover object-[50%_30%] rounded-2xl border border-white/60 dark:border-neutral-800 shadow-xl hero-float ${cls}`}
      />
    </picture>
  ))}
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-float {
      animation: hero-float 7s ease-in-out infinite;
    }
    picture:nth-child(2n) .hero-float {
      animation-delay: -3.5s;
    }
  }
  @keyframes hero-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -8px;
    }
  }
</style>
