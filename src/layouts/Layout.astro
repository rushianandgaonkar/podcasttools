---
import "../styles/global.css";
import { siteConfig } from "../config/site";
import { Navbar } from "../components/layout/Navbar";
import Footer from "../components/layout/Footer.astro";
import { defaultLocale, type SupportedLocale } from "../i18n/languages";
import { getLangFromUrl, getHreflangLinks } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  /** Alt text for the share card; defaults to the page title */
  ogImageAlt?: string;
  noindex?: boolean;
  lang?: SupportedLocale;
}

const {
  title = "Pod Studio — Free Podcast Creator Tools (Titles, Show Notes, CPM, Artwork)",
  description = siteConfig.description,
  canonicalUrl = Astro.url.href,
  ogImage = siteConfig.ogImage,
  ogImageAlt,
  noindex = false,
  lang: propLang,
} = Astro.props;

const lang = propLang || getLangFromUrl(Astro.url);
const fullTitle = title.includes("Pod Studio") ? title : `${title} | Pod Studio`;
// Accept both absolute URLs and root-relative paths (e.g. "/og/tools/slug.png")
const ogImageUrl = ogImage.startsWith("http") ? ogImage : `${siteConfig.url}${ogImage}`;
const ogAlt = ogImageAlt || fullTitle;

// Generate reciprocal hreflang links for SEO across all 8 languages + x-default
const hreflangLinks = getHreflangLinks(Astro.url.pathname, siteConfig.url);

const localeOgMap: Record<string, string> = {
  en: "en_US",
  es: "es_ES",
  ja: "ja_JP",
  fr: "fr_FR",
  de: "de_DE",
  pt: "pt_BR",
  ko: "ko_KR",
  it: "it_IT",
};

const currentOgLocale = localeOgMap[lang] || "en_US";

const jsonLdOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteConfig.url,
  logo: `${siteConfig.url}/icon.svg`,
  description: siteConfig.description,
};

const jsonLdWebsite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.url,
  inLanguage: lang,
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteConfig.url}/tools?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="shortcut icon" href="/icon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Reciprocal hreflang tags for international SEO -->
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.href} />
    ))}

    <!-- Geist & Geist Mono Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Zero-FOUC Theme Script -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme = stored ? stored : prefersDark ? "dark" : "light";
          if (theme === "dark") {
            document.documentElement.classList.add("dark");
            document.documentElement.classList.remove("light");
          } else {
            document.documentElement.classList.add("light");
            document.documentElement.classList.remove("dark");
          }
        } catch (_) {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={currentOgLocale} />
    {Object.entries(localeOgMap)
      .filter(([key]) => key !== lang)
      .map(([_, altLocale]) => (
        <meta property="og:locale:alternate" content={altLocale} />
      ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrg)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)} />
  </head>
  <body class="bg-[#fafafa] dark:bg-[#000000] text-[#171717] dark:text-[#ededed] min-h-screen flex flex-col font-sans selection:bg-[#0070f3]/20 selection:text-[#0070f3] antialiased">
    <Navbar client:load lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
